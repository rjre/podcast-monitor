# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real keys.

# Optional. pipeline/transcribe.py uses this automatically when set, via
# NVIDIA's Nemotron 3.5 ASR model (hosted by DeepInfra) over OpenRouter's
# /api/v1/audio/transcriptions endpoint -- a fast, cheap (~$0.000003/s of
# audio) cloud alternative to local Whisper transcription. Falls back to
# local Whisper when unset. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
